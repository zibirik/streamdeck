<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StreamPanel.Server</AssemblyName>
    <RootNamespace>StreamPanel.Server</RootNamespace>
    <!-- Default for local builds; release builds pass -p:Version=<tag>. -->
    <Version>0.3.0</Version>
    <Company>zibirik</Company>
    <Product>StreamPanel</Product>
    <Copyright>Copyright 2026 zibirik</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Framework-dependent runs (run-server.ps1) also work when only a newer .NET runtime (e.g. 10) is installed.
         The release build is self-contained and does not depend on this. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
</Project>
